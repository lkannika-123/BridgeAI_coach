diff --git a/bridge-ai-source/tests/production.mjs b/bridge-ai-source/tests/production.mjs
new file mode 100644
--- /dev/null
+++ b/bridge-ai-source/tests/production.mjs
@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import worker from '../dist/server/index.js';
+for(const path of ['/','/app.mjs','/catalog.mjs','/matching.mjs','/style.css']){
+ const r=await worker.fetch(new Request('https://bridge.test'+path),{});
+ assert.equal(r.status,200,path);assert.ok((await r.text()).length>500,path);
+}
+const context={schemaVersion:1,industry:'food',task:'Make flyers',description:'Promote our weekly special',currentProcess:'manual',existingTools:{categories:['email'],names:'Gmail'},budget:{monthlyLimit:50},selectedTools:[{id:'canva'}],successMetric:'Record 5 redemptions in one week'};
+let sequence=0;
+const req=()=>new Request('https://bridge.test/api/coach',{method:'POST',headers:{'Content-Type':'application/json','CF-Connecting-IP':'test-'+(++sequence)},body:JSON.stringify(context)});
+let r=await worker.fetch(req(),{});assert.equal(r.status,503);assert.equal((await r.json()).live,false);
+const original=globalThis.fetch;
+try{
+ globalThis.fetch=async()=>new Response(JSON.stringify({choices:[{message:{content:'Review your offer, draft one flyer and track redemptions.'}}]}));
+ r=await worker.fetch(req(),{OPENROUTER_API_KEY:'test-only-not-a-real-key',OPENROUTER_MODEL:'test-model'});assert.equal(r.status,200);assert.equal((await r.json()).live,true);
+ globalThis.fetch=async()=>new Response('Unavailable',{status:502});
+ r=await worker.fetch(req(),{OPENROUTER_API_KEY:'test-only-not-a-real-key',OPENROUTER_MODEL:'test-model'});assert.equal(r.status,503);assert.equal((await r.json()).live,false);
+}finally{globalThis.fetch=original;}
+r=await worker.fetch(new Request('https://bridge.test/'),{});assert.equal(r.status,200);
+console.log('Production Worker passed: five frontend routes, missing key, mocked coach success, provider failure, site still available.');
